# Skopíruj tento súbor ako ".env" (bez "example.") a vyplň vlastné
# hodnoty. Súbor ".env" sa necommituje do gitu (je v .gitignore).

# Tajný kľúč pre Flask session/CSRF. Vygeneruješ ho príkazom:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sem-vloz-vygenerovany-nahodny-retazec

# Minimálny odpočinok medzi dvomi po sebe idúcimi smenami (hodiny).
# Nepovinné - ak vynecháš, použije sa predvolených 12.
MIN_REST_HOURS=12

# Zákonný strop týždenného pracovného času vrátane nadčasov (hodiny).
# Nepovinné - ak vynecháš, použije sa predvolených 48.
MAX_WEEKLY_HOURS_WITH_OVERTIME=48

# Môžu zamestnanci vidieť (len na čítanie) aj smeny kolegov v kalendári
# svojej pobočky? 0 = nie, vidia len vlastný rozpis (predvolené).
EMPLOYEES_CAN_VIEW_BRANCH_CALENDAR=0

# Za HTTPS (nasadenie pre pobočky) nastav na 1 - session cookie sa
# potom posiela len cez šifrované spojenie.
SESSION_COOKIE_SECURE=0

# --- Nasadenie pre viac pobočiek (pozri DEPLOYMENT.md) ---------------

# Databáza. Bez tejto premennej sa používa lokálny SQLite súbor.
# Pre centrálnu inštanciu použi PostgreSQL:
#DATABASE_URL=postgresql://planner:heslo@127.0.0.1:5432/shift_planner

# Appka beží za reverzným proxy (Caddy/nginx) s HTTPS. Zapni LEN ak
# server (manage.py serve) počúva na 127.0.0.1.
BEHIND_PROXY=0

# Pre "python manage.py serve" (predvolené hodnoty):
#HOST=127.0.0.1
#PORT=8000
#THREADS=8

# Adresa dôveryhodného reverzného proxy (pri BEHIND_PROXY=1). Predvolene
# 127.0.0.1 (Caddy na tom istom serveri).
#TRUSTED_PROXY=127.0.0.1

# Ochrana prihlásenia pred hádaním hesiel (predvolené hodnoty):
#LOGIN_MAX_ATTEMPTS=5        # neúspešné pokusy (IP + meno) do zablokovania
#LOGIN_IP_MAX_ATTEMPTS=20    # neúspešné pokusy z jednej IP do zablokovania
#LOGIN_LOCKOUT_MINUTES=15    # dĺžka zablokovania v minútach

# Nové smeny sú predvolene KONCEPT (zamestnanec ich uvidí až po
# "Zverejniť týždeň"). 1 = zverejniť nové smeny hneď.
AUTO_PUBLISH_SHIFTS=0

# Časová zóna, v ktorej sa zobrazujú časy v záznamoch zmien (audit log).
# Predvolene Europe/Bratislava.
#APP_TIMEZONE=Europe/Bratislava

# --- E-mailové upozornenia (pozri DEPLOYMENT.md) ---------------------
# Bez SMTP_HOST sú upozornenia vypnuté.
#SMTP_HOST=smtp.firma.sk
#SMTP_PORT=587                 # 587 pre starttls (predvolené), 465 pre ssl
#SMTP_SECURITY=starttls        # starttls | ssl | none
#SMTP_USER=planner@firma.sk
#SMTP_PASSWORD=heslo
#SMTP_FROM=Plánovač smien <planner@firma.sk>
# Adresa appky - použije sa v odkazoch v e-mailoch.
#APP_BASE_URL=https://plan.firma.sk
